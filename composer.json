{
    "name": "jund-fauz/filament-kompact",
    "description": "A set of helper functions and macros in building app using Filament in Laravel",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "JundFauz\\FilamentKompact\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JundFauz\\FilamentKompact\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "jund-fauz",
            "email": "mujadidjundifauzi200@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "jund-fauz/eloquent-kompact": "^0.100.0",
        "brick/math": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "zvizvi/filament-column-filters": "^0.0.6",
        "orchestra/testbench": "^11.3"
    },
    "suggest": {
        "zvizvi/filament-column-filters": "Required for the createFilter() column macro"
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "JundFauz\\FilamentKompact\\FilamentKompactServiceProvider"
            ]
        }
    }
}
